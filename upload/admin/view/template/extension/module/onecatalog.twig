{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="submit" form="form-onecatalog" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa fa-save"></i></button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}

    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-cog"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action }}" method="post" enctype="multipart/form-data" id="form-onecatalog" class="form-horizontal">

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
            <div class="col-sm-10">
              <select name="module_onecatalog_status" id="input-status" class="form-control">
                <option value="1"{% if fields.module_onecatalog_status %} selected{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not fields.module_onecatalog_status %} selected{% endif %}>{{ text_disabled }}</option>
              </select>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-base">{{ entry_api_base }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_onecatalog_api_base" value="{{ fields.module_onecatalog_api_base }}" id="input-api-base" class="form-control"/>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-api-token">{{ entry_api_token }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_onecatalog_api_token" value="{{ fields.module_onecatalog_api_token }}" id="input-api-token" class="form-control" autocomplete="off"/>
              <div class="text-muted">{{ help_api_token }}</div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-lang">{{ entry_lang }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_onecatalog_lang" value="{{ fields.module_onecatalog_lang }}" id="input-lang" class="form-control" placeholder="en"/>
              <div class="text-muted">{{ help_lang }}</div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-step">{{ entry_step }}</label>
            <div class="col-sm-10">
              <input type="number" min="10" name="module_onecatalog_step" value="{{ fields.module_onecatalog_step }}" id="input-step" class="form-control"/>
              <div class="text-muted">{{ help_step }}</div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-new-status">{{ entry_new_status }}</label>
            <div class="col-sm-10">
              <select name="module_onecatalog_new_status" id="input-new-status" class="form-control">
                <option value="1"{% if fields.module_onecatalog_new_status %} selected{% endif %}>{{ text_enabled }}</option>
                <option value="0"{% if not fields.module_onecatalog_new_status %} selected{% endif %}>{{ text_disabled }}</option>
              </select>
              <div class="text-muted">{{ help_new_status }}</div>
            </div>
          </div>

          <div class="form-group">
            <label class="col-sm-2 control-label" for="input-picker-base">{{ entry_picker_base }}</label>
            <div class="col-sm-10">
              <input type="text" name="module_onecatalog_picker_base" value="{{ fields.module_onecatalog_picker_base }}" id="input-picker-base" class="form-control"/>
              <div class="text-muted">{{ help_picker_base }}</div>
            </div>
          </div>

        </form>
      </div>
    </div>
  </div>
</div>
{{ footer }}
